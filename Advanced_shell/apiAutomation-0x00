#!/bin/bash

#Define the API URL for Pikachu
API_URL="https://pokeapi.co/api/v2/pokemon/pikachu"

# Define the output file
OUTPUT_FILE="data.json"
ERROR_FILE="errors.txt"

# Make the API request using curl
response=$(curl -s -o "$OUTPUT_FILE" -w "%{http_code}" "$API_URL")

# Check if the request was successful (HTTP status code 200)
if [ "$response" -eq 200 ]; then
    echo "API request successful. Data saved to $OUTPUT_FILE."
else
# Log the error to the error file
    echo "Error: API request failed with status code $response" >> "$ERROR_FILE"
    echo "API request failed. Error logged to $ERROR_FILE."
fi    