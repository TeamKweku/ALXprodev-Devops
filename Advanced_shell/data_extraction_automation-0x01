#!/bin/bash

# Check if data.json exists
if [ ! -f "data.json" ]; then
    echo "Error: data.json not found. Please run the API request script first."
    exit 1
fi

# Extract Pokemon data using jq and format with awk and sed
jq -r '[.name, (.types[0].type.name), .weight, .height] | @csv' data.json |
    awk -F',' '{
        gsub(/"/, "", $1)  # Remove quotes from name
        gsub(/"/, "", $2)  # Remove quotes from type
        name=toupper(substr($1,1,1)) substr($1,2)  # Capitalize first letter of name
        type=toupper(substr($2,1,1)) substr($2,2)  # Capitalize first letter of type
        weight=$3/10  # Convert weight from hectograms to kilograms
        height=$4/10  # Convert height from decimeters to meters
        printf "\"%s is of type %s, weighs %gkg, and is %.1fm tall.\"\n", 
        name, type, weight, height
    }'