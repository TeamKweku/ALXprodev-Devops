#!/bin/bash

# List of Pokémon to retrieve data for
pokemon_list=("bulbasaur" "ivysaur" "venusaur" "charmander" "charmeleon")

# Base URL for the Pokémon API
API_URL="https://pokeapi.co/api/v2/pokemon"

# Function to fetch data for a single Pokémon
fetch_pokemon_data() {
    local pokemon=$1
    local output_file="${pokemon}.json"

    echo "Fetching data for $pokemon..."
    curl -s -o "$output_file" "${API_URL}/${pokemon}"

    if [ $? -eq 0 ]; then
        echo "Data saved to $output_file."
    else
        echo "Error: Failed to fetch data for $pokemon."
        rm -f "$output_file"  # Remove the empty or invalid file
    fi
}

# Trap Ctrl+C and cleanup
cleanup() {
    echo "Cleaning up..."
    jobs -p | xargs kill -9 2>/dev/null
    exit 1
}
trap cleanup INT

# Array to store background process IDs
pids=()

# Loop through each Pokémon and fetch data in parallel
for pokemon in "${pokemon_list[@]}"; do
    fetch_pokemon_data "$pokemon" &
    pids+=($!)  # Store the process ID of the background job
done

# Monitor jobs and wait for completion
while true; do
    active_jobs=$(jobs -p | wc -l)
    if [ "$active_jobs" -eq 0 ]; then
        break
    fi
    sleep 1
done

echo "Parallel data fetching complete."